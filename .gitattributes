# Normalise line endings
* text=auto eol=lf

# Unity text assets: keep as text and use Unity's smart merge tool
*.cs        text diff=csharp
*.shader    text
*.cginc     text
*.uss       text
*.uxml      text
*.asmdef    text
*.json      text
*.md        text
*.unity     merge=unityyamlmerge eol=lf
*.prefab    merge=unityyamlmerge eol=lf
*.asset     merge=unityyamlmerge eol=lf
*.mat       merge=unityyamlmerge eol=lf
*.meta      merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf

# Treat these as binary (no diff, no merge, no eol conversion)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.psd   binary
*.tga   binary
*.fbx   binary
*.obj   binary
*.blend binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.aif   binary
*.ttf   binary
*.otf   binary
*.dll   binary
*.a     binary
*.so    binary
*.dylib binary
*.bundle binary
*.unitypackage binary
