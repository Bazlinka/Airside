# Unity generated files
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# IDE and operating system files
.DS_Store
.idea/
.vscode/
*.csproj
*.sln
*.suo
*.user
*.pidb
*.booproj
*.svd

# scripts/dotnet-harness and scripts/hud-mockup are hand-authored projects (not
# Unity/IDE-generated), tracked despite the *.csproj rule above; only their build
# output is ignored.
!/scripts/dotnet-harness/*.csproj
/scripts/dotnet-harness/bin/
/scripts/dotnet-harness/obj/
!/scripts/hud-mockup/*.csproj
/scripts/hud-mockup/bin/
/scripts/hud-mockup/obj/

# Xcode generated output
DerivedData/
xcuserdata/
*.xcworkspace/xcuserdata/

# Local secrets and signing
.env
*.p12
*.mobileprovision

# Local setup downloads and temporary work
/work/

# Unity Test Framework run artifacts (regenerated by every -runTests)
/game/Airside/Assets/Resources/PerformanceTestRunInfo.json*
/game/Airside/Assets/Resources/PerformanceTestRunSettings.json*
/game/Airside/Assets/Resources.meta
__pycache__/

# Finder/iCloud occasionally materialises numbered conflict copies beside generated
# runtime art. The canonical unnumbered assets are rebuilt by the sync script.
/game/Airside/Assets/StreamingAssets/**/* [0-9].*
