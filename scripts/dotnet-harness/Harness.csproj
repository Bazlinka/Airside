<!--
  Headless mirror of the Unity EditMode test run, for machines without Unity
  installed. Compiles Domain/Simulation/Persistence straight from the Unity
  project (no copies) plus the EditMode tests, against HarnessSaveRepository.cs
  standing in for the one file that needs UnityEngine.JsonUtility. Run via
  scripts/test-domain.sh. Supplementary only: scripts/test-unity.sh remains the
  source of truth (it also covers Presentation and the real Unity compile).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../game/Airside/Assets/Airside/Domain/**/*.cs" />
    <Compile Include="../../game/Airside/Assets/Airside/Simulation/**/*.cs" />
    <Compile Include="../../game/Airside/Assets/Airside/Persistence/**/*.cs" Exclude="../../game/Airside/Assets/Airside/Persistence/AirsideSaveRepository.cs" />
    <!--
      AirsideTerrainField, AirsideBareField, AirsideRunwayMarkings and
      AirsideAdelaideGround are Presentation by folder but hold no UnityEngine
      types, so the authored landform / real-metre strip can be checked here
      rather than only under Unity.
      Compiling them means TerrainFieldTests, BareFieldTests and AdelaideGroundTests
      run without an editor.
    -->
    <Compile Include="../../game/Airside/Assets/Airside/Presentation/AirsideTerrainField.cs" />
    <Compile Include="../../game/Airside/Assets/Airside/Presentation/AirsideBareField.cs" />
    <Compile Include="../../game/Airside/Assets/Airside/Presentation/AirsideRunwayMarkings.cs" />
    <Compile Include="../../game/Airside/Assets/Airside/Presentation/AirsideAdelaideGround.cs" />
    <Compile Include="../../game/Airside/Assets/Airside/Tests/EditMode/*.cs" Exclude="../../game/Airside/Assets/Airside/Tests/EditMode/PresentationLayoutTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/AircraftAssetTests.cs" />
  </ItemGroup>

</Project>
