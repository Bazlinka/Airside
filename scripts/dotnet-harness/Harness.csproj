      instead of letting the compile error hide every other result.
    -->
    <Compile Include="../../game/Airside/Assets/Airside/Tests/EditMode/*.cs" Exclude="../../game/Airside/Assets/Airside/Tests/EditMode/TerminalUndercroftMeshTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/ArrivalMapTrackTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/ShaderInclusionTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/RoadMarkingPlanTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/PresentationLayoutTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/AircraftAssetTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/CircuitPresentationLogicTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/AirlineSaveTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/AdelaidePavementTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/AircraftDispatchTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/HudHitTestTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/TerminalGateOperationsTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/AircraftCatalogueTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/EnrouteProfileTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/AdelaideGroundLookTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/AirsideNamedChildrenTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/FieldMiniMapTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/AirsideTerrainGroundCalibrationTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/PresentationBugSweepTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/MeshNormalSmoothingTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/AirsideSettingsTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/TaxiRunwayNightTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/GroundSeparationTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/AirsideFramePacingTests.cs;../../game/Airside/Assets/Airside/Tests/EditMode/PropellerDynamicsTests.cs;../../game/Airside/Assets/Airside/T