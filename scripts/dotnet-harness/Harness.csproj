<!--
  Headless mirror of the Unity EditMode test run, for machines without Unity
  installed. Compiles Domain/Simulation straight from the Unity project (no
  copies) plus the EditMode tests. Run via scripts/test-domain.sh.
  Supplementary only: scripts/test-unity.sh remains the source of truth (it
  also covers Presentation and the real Unity compile).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Off on purpose: Unity has no implicit usings, so a missing `using System;` must fail here exactly as it fails in Unity (ADR 0252). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!--
      Tests RUN on NUnit 3.14 (3.5 has no .NET 8 assets). Unity Test Framework 1.6 bundles NUnit 3.5, so a compile-only build with
      -p:UnityNUnit=true (scripts/check-unity-nunit.sh, CI) rejects constraints Unity lacks, e.g. Is.AnyOf (ADR 0252).
    -->
    <PackageReference Include="NUnit" Version="3.14.0" Condition="'$(UnityNUnit)' != 'true'" />
    <PackageReference Include="NUnit" Version="3.5.0" Condition="'$(UnityNUnit)' == 'true'" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../game/Airside/Assets/Airside/Domain/**/*.cs" />
    <Compile Include="../../game/Airside/Assets/Airside/Simulation/**/*.cs" />
    <!--
      Which Presentation files and EditMode tests compile without UnityEngine is derived, not listed:
      scripts/update-harness.py writes Harness.Generated.props (run it after adding a file; CI checks it).
    -->
  </ItemGroup>

  <Import Project="Harness.Generated.props" />

</Project>
